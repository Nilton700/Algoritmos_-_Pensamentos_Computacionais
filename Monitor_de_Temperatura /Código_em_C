#include <stdio.h>

int main() {

    // aqui estou declarando as variáveis
    float temperatura;
    float soma = 0;
    float maior = 0;
    float menor = 0;
    float media;
    int quantidade = 0;
    int alertas = 0;
    char saida[20];

    // aqui é onde começa o laço de "do...while"
    do {

        // pedindo para o usuário digitar um valor para a temperatura ou 'x' para sair
        printf("\nDigite a temperatura em °C");
        printf(" (ou digite x para sair): ");
        scanf("%s", saida);

        if (saida[0] == 'x' || saida[0] == 'X') {
            break;
        }

        // invalidando o que o usuário digitou caso não tenha digitado um número 
        if (sscanf(saida, "%f", &temperatura) != 1) {
            printf("Valor inválido! Digite uma temperatura numerica.\n");
            continue;
        }

        // colocando a condição de não aceitar valores abaixo de zero absoluto
        if (temperatura < -273.15) {

            printf("Temperatura inválida!\n");
            printf("Temperaturas abaixo do zero absoluto(-273.15 °C) não são válidas...\n");

            continue;
        }

        quantidade++;
        soma += temperatura;

        // definindo a maior e a menor temperatura
        if (quantidade == 1) {
            maior = temperatura;
            menor = temperatura;
        } else {

            if (temperatura > maior) {
                maior = temperatura;
            }

            if (temperatura < menor) {
                menor = temperatura;
            }
        }

        // aqui é onde defino que a condição de alertar caso ultrapasse o limite
        if (temperatura > 80) {

            alertas++;

            printf("ALERTA! Temperatura acima de 80°C!\n");
            printf("Alertas consecutivos: %d\n", alertas);

        } else {
            alertas = 0;
            
            printf("Temperatura está dentro do limite.\n");
        }

    } while (alertas < 3);

    printf("\n====================================\n");
    printf("          RELATÓRIO FINAL\n");
    printf("====================================\n");

    if (quantidade > 0) {

        media = soma / quantidade;

        printf("Quantidade final de temperaturas: %d\n", quantidade);
        printf("Média das temperaturas: %.2f °C\n", media);
        printf("Maior temperatura registrada: %.2f °C\n", maior);
        printf("Menor temperatura registrada: %.2f °C\n", menor);

    } else {

        printf("Nenhuma temperatura válida foi informada.\n");
    }

    // aqui é onde caso o usuário ultrapasse o limite 3 vezes consecutivas o programa se encerra
    if (alertas >= 3) {

        printf("\nForam registradas 3 temperaturas consecutivas acima de 80°C.\n");
        printf("O programa foi encerrado automaticamente.\n");

    } else {

        printf("\nO programa foi encerrado pelo usuario.\n");
    }

    printf("====================================\n");

    return 0;
}
